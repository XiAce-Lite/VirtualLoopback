<?xml version="1.0" encoding="UTF-8"?>

<JUCERPROJECT id="VLbk01" name="VirtualLoopback" projectType="audioplug"
              useAppConfig="0" addUsingNamespaceToJuceHeader="0" jucerFormatVersion="1"
              companyName="XiAceLite" companyWebsite="https://github.com/XiAce-Lite"
              pluginCharacteristicsValue="pluginIsSynth"
              pluginManufacturer="XiAceLite"
              pluginManufacturerCode="XiAL" pluginCode="VLbk"
              pluginVST3Category="Instrument"
              pluginName="VirtualLoopback" pluginDesc="PC再生音のWASAPIループバック取り込み"
              pluginAUMainType="'aumu'" pluginVSTCategory="kPlugCategSynth"
              version="1.0.0">
  <MAINGROUP id="VLMain" name="VirtualLoopback">
    <GROUP id="{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}" name="Source">
      <FILE id="VLCapH" name="WasapiLoopbackCapture.h" compile="0" resource="0"
            file="Source/WasapiLoopbackCapture.h"/>
      <FILE id="VLCapC" name="WasapiLoopbackCapture.cpp" compile="1" resource="0"
            file="Source/WasapiLoopbackCapture.cpp"/>
      <FILE id="VLProcC" name="PluginProcessor.cpp" compile="1" resource="0"
            file="Source/PluginProcessor.cpp"/>
      <FILE id="VLProcH" name="PluginProcessor.h" compile="0" resource="0"
            file="Source/PluginProcessor.h"/>
      <FILE id="VLEditC" name="PluginEditor.cpp" compile="1" resource="0"
            file="Source/PluginEditor.cpp"/>
      <FILE id="VLEditH" name="PluginEditor.h" compile="0" resource="0"
            file="Source/PluginEditor.h"/>
    </GROUP>
  </MAINGROUP>
  <MODULES>
    <MODULE id="juce_audio_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_devices" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_formats" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_plugin_client" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_processors" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_utils" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_core" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_data_structures" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_events" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_graphics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_gui_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_gui_extra" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
  </MODULES>
  <JUCEOPTIONS JUCE_STRICT_REFCOUNTEDPOINTER="1" JUCE_VST3_CAN_REPLACE_VST2="0"/>
  <EXPORTFORMATS>
    <VS2022 targetFolder="Builds/VisualStudio2022">
      <CONFIGURATIONS>
        <CONFIGURATION isDebug="1" name="Debug" targetName="VirtualLoopback"
                       extraCompilerFlags="/utf-8"/>
        <CONFIGURATION isDebug="0" name="Release" targetName="VirtualLoopback"
                       extraCompilerFlags="/utf-8"/>
      </CONFIGURATIONS>
      <MODULEPATHS>
        <MODULEPATH id="juce_audio_basics" path="F:/JUCE/modules"/>
        <MODULEPATH id="juce_audio_devices" path="F:/JUCE/modules"/>
        <MODULEPATH id="juce_audio_formats" path="F:/JUCE/modules"/>
        <MODULEPATH id="juce_audio_plugin_client" path="F:/JUCE/modules"/>
        <MODULEPATH id="juce_audio_processors" path="F:/JUCE/modules"/>
        <MODULEPATH id="juce_audio_utils" path="F:/JUCE/modules"/>
        <MODULEPATH id="juce_core" path="F:/JUCE/modules"/>
        <MODULEPATH id="juce_data_structures" path="F:/JUCE/modules"/>
        <MODULEPATH id="juce_events" path="F:/JUCE/modules"/>
        <MODULEPATH id="juce_graphics" path="F:/JUCE/modules"/>
        <MODULEPATH id="juce_gui_basics" path="F:/JUCE/modules"/>
        <MODULEPATH id="juce_gui_extra" path="F:/JUCE/modules"/>
      </MODULEPATHS>
    </VS2022>
  </EXPORTFORMATS>
</JUCERPROJECT>
